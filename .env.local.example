# Groq API Key — get free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Product Hunt API token (optional — improves PH data)
# Get at https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=

# GitHub token (optional — raises GitHub API limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=

# Reddit app credentials (optional — adds upvote/comment counts; without them Reddit posts show without scores)
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Node environment
NODE_ENV=development
